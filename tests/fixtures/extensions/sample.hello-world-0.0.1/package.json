{
  "name": "hello-world",
  "publisher": "sample",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.0.1",
  "engines": { "vscode": "^1.80.0" },
  "main": "./extension.js",
  "capabilities": { "untrustedWorkspaces": { "supported": true } },
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      { "command": "helloWorld.sayHello", "title": "%command.sayHello%", "category": "Hello" },
      { "command": "helloWorld.askChoice", "title": "Ask a Choice", "category": "Hello" },
      { "command": "helloWorld.fail", "title": "Fail", "category": "Hello" },
      { "command": "helloWorld.upperFirstLine", "title": "Upper-case First Line", "category": "Hello" },
      { "command": "helloWorld.pick", "title": "Pick a Fruit", "category": "Hello" },
      { "command": "helloWorld.openPanel", "title": "Open Panel", "category": "Hello" },
      { "command": "helloWorld.showDiff", "title": "Show Diff", "category": "Hello" },
      { "command": "helloWorld.listTabs", "title": "List Tabs", "category": "Hello" },
      { "command": "helloWorld.internal", "title": "Internal" }
    ],
    "viewsContainers": {
      "activitybar": [
        { "id": "hello-sidebar", "title": "Hello", "icon": "media/hello.svg" },
        { "id": "hello-hidden", "title": "Hidden", "icon": "media/hello.svg", "when": "helloWorld.showHidden" }
      ]
    },
    "views": {
      "hello-sidebar": [ { "type": "webview", "id": "helloWorld.view", "name": "Greeter" } ],
      "hello-hidden": [ { "type": "webview", "id": "helloWorld.hiddenView", "name": "Hidden" } ]
    },
    "menus": {
      "commandPalette": [ { "command": "helloWorld.internal", "when": "false" } ]
    },
    "configuration": {
      "title": "Hello World",
      "properties": {
        "helloWorld.greeting": { "type": "string", "default": "Hello" }
      }
    }
  }
}
